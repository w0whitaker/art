---
layout: "layouts/base.njk"
---
<header>
  <h1>{{ metadata.title | titleCase }}</h1>
  <nav>
    <ul>
      {%- for entry in collections.all | eleventyNavigation -%}
        <li>
          <a href="{{ entry.url }}">{{ entry.title | titleCase }}</a>
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</header>
{{ content | safe }}
<footer>
  <p>{{ metadata.displayName }}</p>
  <p>get in touch: william at williamwhitaker dot art</p>
</footer>